---
import Layout from "../layouts/Layout.astro";
import Section from "../components/ui/Section.astro";
import Button from "../components/ui/Button.astro";
import InfoBadge from "../components/ui/InfoBadge.astro";
import Glow from "../components/ui/Glow.astro";
---

<Layout 
  title="Página no encontrada (404)" 
  description="La página de este curso no existe o fue movida. Regresa al inicio para ver todos los cursos disponibles en IESL Institute."
>
  <Section class="relative overflow-hidden min-h-[70vh] flex items-center justify-center">
    <!-- Decorative Glows for Premium Ambient Lighting -->
    <Glow
      position="top-1/2 left-1/2"
      color="primary"
      size="w-[450px] h-[450px]"
      class="-translate-x-1/2 -translate-y-1/2 opacity-30"
    />
    <Glow
      position="top-1/3 left-1/3"
      color="secondary"
      size="w-[300px] h-[300px]"
      class="-translate-x-1/2 -translate-y-1/2 opacity-15"
    />

    <div class="max-w-2xl mx-auto flex flex-col items-center text-center relative z-10 py-8">
      <InfoBadge text="Error de navegación" />
      
      <h1 class="text-6xl sm:text-7xl md:text-8xl font-black text-gray-900 tracking-tight leading-none mb-6">
        Error <span class="text-primary">404</span>
      </h1>
      
      <p class="text-gray-600 mb-10 leading-relaxed font-medium text-lg max-w-lg">
        La página de este curso no existe o fue movida temporalmente. Regresa al inicio para explorar nuestra oferta académica completa.
      </p>
      
      <Button href="/" variant="primary" icon="fluent:arrow-right-16-filled">
        Volver al inicio
      </Button>
    </div>
  </Section>
</Layout>
