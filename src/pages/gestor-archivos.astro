---
export const prerender = false;

// ── Aislamiento por subdominio ────────────────────────────────────────────────
const url = new URL(Astro.request.url);
const hostname = url.hostname;
const isAllowedHost =
  hostname === "ieslinstitute.com" ||
  hostname === "www.ieslinstitute.com" ||
  hostname === "gestor.ieslinstitute.com" ||
  hostname === "localhost" ||
  hostname === "127.0.0.1" ||
  import.meta.env.DEV;

if (!isAllowedHost) {
  return new Response(null, { status: 404 });
}
import AdminLayout from "../layouts/AdminLayout.astro";
---

<AdminLayout title="Gestor de Archivos — IESL">
<!-- ══ VISTA 1: Login ════════════════════════════════════════════════ -->
      <div id="loginView" style="display:none;" class="flex-1 flex items-center justify-center p-6">
        <div class="max-w-md w-full bg-white rounded-2xl shadow-xl border border-gray-100 p-10">
          <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl mb-4" style="background-color: color-mix(in srgb, var(--color-primary) 12%, white); border: 1.5px solid color-mix(in srgb, var(--color-primary) 25%, white);">
              <!-- Icono candado -->
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8" style="color: var(--color-primary);">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
              </svg>
            </div>
            <h1 style="font-family:'Poppins',sans-serif; font-size:1.7rem; font-weight:700; color:#111827;">Gestor de Archivos</h1>
            <p class="text-gray-400 mt-1" style="font-size: 16px;">IESL Institute &middot; Acceso Privado</p>
          </div>

          <div class="space-y-4">
            <div>
              <label for="loginToken" class="block font-semibold text-gray-700 mb-1.5" style="font-size: 16px;">Clave de acceso</label>
              <input
                type="password"
                id="loginToken"
                placeholder="••••••••••••"
                autocomplete="current-password"
                class="w-full px-4 py-3 rounded-xl border border-gray-200 bg-gray-50 transition-all focus:outline-none focus:ring-2"
                style="font-size: 17px; --tw-ring-color: var(--color-primary);"
              />
            </div>

            <div id="loginError" class="hidden p-3 bg-red-50 text-red-600 rounded-xl border border-red-100 font-medium" style="font-size: 16px;"></div>

            <button
              id="loginBtn"
              type="button"
              class="w-full flex items-center justify-center gap-2 py-3.5 px-6 rounded-xl font-bold text-white transition-all hover:opacity-90 active:scale-[0.98] cursor-pointer"
              style="background-color: var(--color-primary); font-size: 17px; font-family:'Poppins',sans-serif;"
            >
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15m3 0 3-3m0 0-3-3m3 3H9" />
              </svg>
              Ingresar
            </button>
          </div>
        </div>
      </div>

      <!-- ══ VISTA 2: Dashboard ═════════════════════════════════════════════ -->
      <div id="dashboardView" style="display:none;" class="flex-col flex-1 animate-fade-in">

        <!-- Top Bar -->
        <header class="bg-white border-b border-gray-200 px-4 sm:px-6 py-4 flex flex-col sm:flex-row items-center justify-between gap-4 sticky top-0 z-10 shadow-sm">
          <div class="flex items-center gap-3 w-full sm:w-auto justify-between sm:justify-start">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0" style="background-color: color-mix(in srgb, var(--color-primary) 12%, white); color: var(--color-primary);">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15a4.5 4.5 0 0 0 4.5 4.5H18a3.75 3.75 0 0 0 1.332-7.257 3 3 0 0 0-3.758-3.848 5.25 5.25 0 0 0-10.233 2.33A4.502 4.502 0 0 0 2.25 15Z" />
                </svg>
              </div>
              <h2 class="font-bold text-gray-900" style="font-size: 20px; font-family:'Poppins',sans-serif;">
                Gestor de Archivos
              </h2>
            </div>
            <!-- Botones visibles solo en móviles, en la misma línea del título -->
            <div class="flex sm:hidden items-center gap-2 shrink-0">
              <button id="refreshBtnMobile" type="button" class="flex items-center justify-center text-gray-600 w-10 h-10 rounded-xl border border-gray-200 hover:bg-gray-50 transition-all cursor-pointer">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" />
                </svg>
              </button>
              <button id="logoutBtnMobile" type="button" class="flex items-center justify-center text-red-600 w-10 h-10 rounded-xl border border-red-200 bg-red-50 hover:bg-red-100 transition-all cursor-pointer">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 9V5.25A2.25 2.25 0 0 1 10.5 3h6a2.25 2.25 0 0 1 2.25 2.25v13.5A2.25 2.25 0 0 1 16.5 21h-6a2.25 2.25 0 0 1-2.25-2.25V15m-3 0-3-3m0 0 3-3m-3 3H15" />
                </svg>
              </button>
            </div>
          </div>
          
          <!-- Botones visibles solo en escritorio -->
          <div class="hidden sm:flex items-center gap-3">
            <button id="refreshBtn" type="button" class="flex items-center gap-1.5 font-semibold text-gray-600 px-4 py-2 rounded-xl border border-gray-200 hover:bg-gray-50 transition-all cursor-pointer" style="font-size: 15px;">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" />
              </svg>
              Actualizar
            </button>
            <button id="logoutBtn" type="button" class="flex items-center gap-1.5 font-semibold text-red-600 px-4 py-2 rounded-xl border border-red-200 bg-red-50 hover:bg-red-100 transition-all cursor-pointer" style="font-size: 15px;">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 9V5.25A2.25 2.25 0 0 1 10.5 3h6a2.25 2.25 0 0 1 2.25 2.25v13.5A2.25 2.25 0 0 1 16.5 21h-6a2.25 2.25 0 0 1-2.25-2.25V15m-3 0-3-3m0 0 3-3m-3 3H15" />
              </svg>
              Cerrar sesión
            </button>
          </div>
        </header>

        <!-- Content -->
        <main class="flex-1 p-6 md:p-8 max-w-5xl mx-auto w-full flex flex-col">
          <section class="flex-1 flex flex-col">
            <div class="bg-white rounded-2xl border border-gray-200 shadow-sm flex flex-col flex-1 min-h-[400px]">
              <div class="px-5 py-4 border-b border-gray-100 bg-gray-50 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                <h3 class="font-bold text-gray-800 flex items-center gap-2" style="font-size: 15px; font-family:'Poppins',sans-serif;">
                  Lista de archivos
                  <span id="filesCount" class="bg-gray-200 text-gray-600 px-2 py-0.5 rounded-full font-semibold" style="font-size: 13px;">—</span>
                </h3>
                <button id="openUploadModalBtn" type="button"
                  class="w-full sm:w-auto flex items-center justify-center gap-2 py-2 px-4 rounded-xl font-bold text-white transition-all hover:opacity-90 active:scale-[0.98] cursor-pointer"
                  style="background-color: var(--color-primary); font-size: 14px; font-family:'Poppins',sans-serif;"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                  </svg>
                  Subir nuevo archivo
                </button>
              </div>
              <div class="flex-1 overflow-auto">
                <table class="w-full text-left min-w-[480px]">
                  <thead class="bg-gray-50 border-b border-gray-100 text-gray-400 uppercase tracking-wider font-semibold sticky top-0 z-10" style="font-size: 12px;">
                    <tr>
                      <th class="px-5 py-3">Nombre</th>
                      <th class="px-5 py-3">Tamaño</th>
                      <th class="px-5 py-3">Subido</th>
                      <th class="px-5 py-3 w-16"></th>
                    </tr>
                  </thead>
                  <tbody id="filesTableBody" class="divide-y divide-gray-100" style="font-size: 15px;">
                    <tr>
                      <td colspan="4" class="px-5 py-14 text-center text-gray-400">
                        <span class="spinner"></span>Cargando archivos...
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </section>
        </main>
      </div>

      <!-- ══ SPINNER INICIAL mientras JS decide qué vista mostrar ═════════ -->
      <div id="initSpinner" class="flex-1 flex items-center justify-center">
        <span class="spinner" style="width:2rem; height:2rem; border-width:3px;"></span>
      </div>



    <!-- ══ MODAL UNIFICADO: Subir / Editar archivo ═══════════════════════════════════════════ -->
    <div id="modalFile" style="display:none;" class="fixed inset-0 z-50 flex items-center justify-center p-4">
      <!-- Backdrop -->
      <div id="modalFileBackdrop" class="absolute inset-0 bg-black/50" style="backdrop-filter: blur(4px);"></div>
      <!-- Panel -->
      <div class="relative bg-white rounded-2xl shadow-2xl border border-gray-100 w-full max-w-lg animate-fade-in overflow-hidden">
        <!-- Header -->
        <div class="px-6 py-4 border-b border-gray-100 bg-gray-50 flex items-center justify-between">
          <h3 id="modalFileTitle" class="font-bold text-gray-800 flex items-center gap-2" style="font-size: 16px; font-family:'Poppins',sans-serif;">
            <!-- El icono y texto se inyecta por JS -->
          </h3>
          <button id="modalFileClose" type="button" class="w-8 h-8 flex items-center justify-center rounded-lg text-gray-400 hover:text-gray-600 hover:bg-gray-100 transition-all cursor-pointer" style="font-size: 18px;">
            ✕
          </button>
        </div>
        <!-- Body -->
        <div class="p-6 space-y-5">
          <!-- Info del archivo actual (solo en edición) -->
          <div id="modalFileCurrentInfo" class="hidden p-3 bg-gray-50 rounded-xl border border-gray-100">
            <p class="text-gray-400" style="font-size: 12px;">Archivo actual</p>
            <p id="modalFileCurrentName" class="font-semibold text-gray-800 break-all" style="font-size: 14px;"></p>
          </div>
          
          <!-- Drop zone -->
          <div class="space-y-1.5">
            <label id="modalFileDropLabel" class="block font-semibold text-gray-700" style="font-size: 14px;">
              Archivo
            </label>
            <div id="modalFileDropZone" class="relative border-2 border-dashed border-gray-200 rounded-xl p-6 text-center cursor-pointer transition-all">
              <input type="file" id="modalFileInput" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10" />
              <div class="w-11 h-11 mx-auto bg-gray-100 rounded-xl flex items-center justify-center mb-3 text-gray-400">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5" />
                </svg>
              </div>
              <p class="text-gray-500" style="font-size: 14px;">Arrastra un archivo o <strong style="color: var(--color-primary);">haz clic</strong></p>
            </div>
            <div id="modalFileName" class="hidden px-3 py-2 rounded-xl font-medium text-center break-all border" style="font-size: 13px; background-color: color-mix(in srgb, var(--color-primary) 8%, white); color: var(--color-primary); border-color: color-mix(in srgb, var(--color-primary) 25%, white);"></div>
          </div>

          <!-- Campo: Enlace personalizado -->
          <div class="space-y-1.5">
            <label for="modalKeyInput" class="block font-semibold text-gray-700" style="font-size: 14px;">Enlace público <span id="modalKeyOptional" class="font-normal text-gray-400">(opcional)</span></label>
            <div class="flex items-center gap-0 rounded-xl border border-gray-200 bg-gray-50 overflow-hidden transition-all focus-within:ring-2" style="--tw-ring-color: var(--color-primary);">
              <span class="pl-3 pr-1 text-gray-400 whitespace-nowrap select-none shrink-0" style="font-size: 13px;">archivos.ieslinstitute.com/</span>
              <input type="text" id="modalKeyInput" class="flex-1 px-2 py-2.5 bg-transparent border-none outline-none" style="font-size: 14px;" />
              <span id="modalKeyExt" class="pr-3 pl-1 text-gray-400 whitespace-nowrap select-none shrink-0 hidden" style="font-size: 13px; font-weight: 500;"></span>
            </div>
          </div>
          
          <div id="modalProgressWrap" class="hidden h-1.5 w-full bg-gray-100 rounded-full overflow-hidden">
            <div id="modalProgressBar" class="h-full w-0 rounded-full transition-all duration-300" style="background-color: var(--color-primary);"></div>
          </div>

          <!-- Status -->
          <div id="modalFileStatus" class="hidden p-3 font-medium rounded-xl border text-center" style="font-size: 14px;"></div>
        </div>
        <!-- Footer -->
        <div class="px-6 py-4 border-t border-gray-100 bg-gray-50 flex items-center justify-between gap-3">
          <button id="modalFileDeleteBtn" type="button"
            class="hidden items-center gap-1.5 font-semibold px-4 py-2.5 rounded-xl transition-all cursor-pointer text-red-600 bg-red-50 border border-red-200 hover:bg-red-100"
            style="font-size: 14px;">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
            </svg>
            Eliminar
          </button>
          <div class="flex items-center gap-3 ml-auto">
            <button id="modalFileCancelBtn" type="button"
              class="font-semibold px-5 py-2.5 rounded-xl transition-all cursor-pointer text-gray-600 bg-white border border-gray-200 hover:bg-gray-50"
              style="font-size: 14px;">
              Cancelar
            </button>
            <button id="modalFileSaveBtn" type="button"
              class="flex items-center gap-1.5 font-bold px-5 py-2.5 rounded-xl text-white transition-all cursor-pointer hover:opacity-90 active:scale-[0.98] disabled:opacity-40 disabled:cursor-not-allowed"
              style="background-color: var(--color-primary); font-size: 14px; font-family:'Poppins',sans-serif;">
              <!-- El icono y texto se inyecta por JS -->
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Global Toast Notification -->
    <div id="toastNotification" class="hidden">
      <span id="toastIcon"></span>
      <span id="toastMessage"></span>
    </div>

        <script src="../scripts/admin/gestor-archivos.ts"></script>
</AdminLayout>
