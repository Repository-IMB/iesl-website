---
import Layout from "../layouts/Layout.astro";
import Section from "../components/ui/Section.astro";
import MatriculaForm from "../components/matricula/MatriculaForm.astro";
import { Icon } from "astro-icon/components";
import { SUPPORT_PHONE, SUPPORT_PHONE_DISPLAY, ACADEMIC_SUPPORT_EMAIL, CUSTOMER_MANAGEMENT_EMAIL } from "../constants/consts";
---

<Layout 
  title="Ficha de Matrícula" 
  description="Estás a un paso de transformar tu carrera profesional con IMB Institute."
>
  <div class="bg-gray-50 min-h-screen">
    <Section class="pt-24 md:pt-32">
      <div class="flex flex-col lg:flex-row gap-8 items-start">
        <!-- Columna Izquierda: Formulario -->
        <div class="w-full lg:w-8/12 bg-white rounded-3xl p-6 md:p-10 shadow-sm border border-gray-100 min-w-0">
          <div class="mb-8 border-b border-gray-100 pb-8">
            <h1 class="font-poppins font-bold text-3xl md:text-4xl text-gray-900 mb-4 tracking-tight">
              FICHA DE MATRÍCULA
            </h1>
            <p class="font-poppins font-semibold text-lg text-primary mb-3">
              ¡Bienvenido a bordo! Completala en menos de 3 minutos.
            </p>
            <p class="font-inter text-gray-600 mb-1">
              Estás a un paso de transformar tu carrera profesional con IESL Institute.
            </p>
            <p class="font-inter text-gray-600">
              Asegura tu vacante y accede a los bonus exclusivos para ti.
            </p>
          </div>
          
          <MatriculaForm />
        </div>

        <!-- Columna Derecha: Información adicional -->
        <div class="w-full  lg:w-4/12 flex flex-col gap-6 md:sticky md:top-24 min-w-0">
          <div class="bg-white rounded-3xl p-6 shadow-sm border border-gray-100">
            <h3 class="font-poppins font-bold text-xl text-gray-900 mb-3 tracking-tight">¿Te ayudamos con tu inscripción?</h3>
            <p class="text-sm text-gray-600 font-inter leading-relaxed">
              Sabemos que dar el paso para capacitarte es importante. Si tienes alguna duda sobre el formulario, los medios de pago o los detalles del programa, nuestro equipo está listo para asistirte.
            </p>
          </div>

          <div class="bg-white rounded-3xl p-6 shadow-sm border border-gray-100">
            <h4 class="font-poppins font-bold text-lg text-primary mb-4 flex items-center gap-2">
              <Icon name="tabler:books" class="text-2xl" />
              Soporte Académico
            </h4>
            <p class="text-sm text-gray-600 mb-5 font-inter">
              Resolvemos tus dudas sobre cursos, horarios, temarios y certificaciones.
            </p>
            <ul class="space-y-4 font-inter text-sm text-gray-700">
              <li class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-full bg-primary/10 flex items-center justify-center shrink-0">
                  <Icon name="tabler:mail" class="text-primary text-xl" />
                </div>
                <a href={`mailto:${ACADEMIC_SUPPORT_EMAIL}`} class="hover:text-primary transition-colors font-medium break-all">{ACADEMIC_SUPPORT_EMAIL}</a>
              </li>
              <li class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-full bg-primary/10 flex items-center justify-center shrink-0">
                  <Icon name="tabler:brand-whatsapp" class="text-primary text-xl" />
                </div>
                <a href={`https://wa.me/${SUPPORT_PHONE}`} target="_blank" rel="noopener noreferrer" class="hover:text-primary transition-colors font-medium">{SUPPORT_PHONE_DISPLAY}</a>
              </li>
              <li class="flex items-start gap-3">
                <div class="w-9 h-9 rounded-full bg-gray-100 flex items-center justify-center shrink-0">
                  <Icon name="tabler:clock" class="text-gray-500 text-xl" />
                </div>
                <span class="mt-1.5 leading-tight text-gray-600">Lunes a Viernes de 9:00 a.m. a 6:00 p.m. (Hora Lima GMT-5)</span>
              </li>
            </ul>
          </div>

          <div class="bg-white rounded-3xl p-6 shadow-sm border border-gray-100">
            <h4 class="font-poppins font-bold text-lg text-secondary mb-4 flex items-center gap-2">
              <Icon name="tabler:receipt" class="text-2xl" />
              Soporte Administrativo
            </h4>
            <p class="text-sm text-gray-600 mb-5 font-inter">
              ¿Problemas con el pago, facturación o llenado de la ficha? Contáctanos directamente.
            </p>
            <ul class="space-y-4 font-inter text-sm text-gray-700">
              <li class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-full bg-secondary/10 flex items-center justify-center shrink-0">
                  <Icon name="tabler:mail" class="text-secondary text-xl" />
                </div>
                <a href={`mailto:${CUSTOMER_MANAGEMENT_EMAIL}`} class="hover:text-secondary transition-colors font-medium break-all">{CUSTOMER_MANAGEMENT_EMAIL}</a>
              </li>
              <li class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-full bg-secondary/10 flex items-center justify-center shrink-0">
                  <Icon name="tabler:brand-whatsapp" class="text-secondary text-xl" />
                </div>
                <a href={`https://wa.me/${SUPPORT_PHONE}`} target="_blank" rel="noopener noreferrer" class="hover:text-secondary transition-colors font-medium">{SUPPORT_PHONE_DISPLAY}</a>
              </li>
              <li class="flex items-start gap-3">
                <div class="w-9 h-9 rounded-full bg-gray-100 flex items-center justify-center shrink-0">
                  <Icon name="tabler:clock" class="text-gray-500 text-xl" />
                </div>
                <span class="mt-1.5 leading-tight text-gray-600">Lunes a Viernes de 9:00 a.m. a 6:00 p.m. (Hora Lima GMT-5)</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </Section>
  </div>
</Layout>
