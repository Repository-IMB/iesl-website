---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Section from "../../components/ui/Section.astro";

import CourseHeader from "../../components/cursos/details/CourseHeader.astro";
import CourseSidebar from "../../components/cursos/details/CourseSidebar.astro";
import CourseContentBody from "../../components/cursos/details/CourseContentBody.astro";
import TestimonialsSection from "../../components/shared/TestimonialsSection.astro";
import CertificationsSection from "../../components/shared/CertificationsSection.astro";
import ContactSection from "../../components/cursos/ContactSection.astro";
import SmartImage from "../../components/ui/SmartImage.astro";
import certificateImg from "../../assets/images/cursos/certificado.webp";
import { aFichaDeCurso, getModulosDeCurso } from "../../lib/aula/content";

// La ruta sirve dos orígenes con el mismo diseño:
//  - `courses`: el catálogo comercial, que se vende por WhatsApp.
//  - `aulaCursos`: los cursos beneficio, cuya ficha lleva al aula.
// El curso del aula no se duplica en `courses`: se mapea al mismo tipo con
// `aFichaDeCurso()`, así el contenido tiene una sola fuente.
export async function getStaticPaths() {
  const comerciales = await getCollection("courses");
  const beneficios = await getCollection("aulaCursos");

  return [
    ...comerciales.map((entry) => ({
      params: { slug: entry.id },
      props: { entry, esBeneficio: false },
    })),
    ...beneficios.map((entry) => ({
      params: { slug: entry.id },
      props: { entry, esBeneficio: true },
    })),
  ];
}

interface Props {
  entry: CollectionEntry<"courses"> | CollectionEntry<"aulaCursos">;
  esBeneficio: boolean;
}

const { entry, esBeneficio } = Astro.props;
const { Content } = await render(entry as CollectionEntry<"courses">);

const ficha = esBeneficio
  ? aFichaDeCurso(
      entry as CollectionEntry<"aulaCursos">,
      await getModulosDeCurso(entry.id)
    )
  : null;

const course = ficha ?? (entry.data as CollectionEntry<"courses">["data"]);

const modules = course.modules;
const instructors = course.instructors;

// Datos estructurados para rich snippets de cursos en Google.
const totalHours = parseInt(course.details.totalHours, 10);
const courseJsonLd: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "Course",
  name: course.title,
  description: course.description,
  provider: {
    "@type": "Organization",
    name: "IESL Institute",
    url: (Astro.site || Astro.url.origin).toString(),
  },
  hasCourseInstance: {
    "@type": "CourseInstance",
    courseMode: "Online",
    ...(Number.isFinite(totalHours) ? { courseWorkload: `PT${totalHours}H` } : {}),
    instructor: instructors
      .filter((i) => i.name?.trim())
      .map((i) => ({ "@type": "Person", name: i.name, jobTitle: i.role })),
  },
  ...(course.reviews
    ? {
        aggregateRating: {
          "@type": "AggregateRating",
          ratingValue: course.rating,
          reviewCount: course.reviews,
        },
      }
    : {}),
};
---

<Layout
  title={course.title}
  description={course.description}
  ogImage={course.image}
  jsonLd={[courseJsonLd]}
>
  <!-- Main content del curso -->
  <Section class="py-12 md:py-16">
    <!-- Grid Layout 2 Columnas -->
    <div class="grid lg:grid-cols-[1fr_380px] gap-12 lg:gap-16">
      
      <!-- Columna Principal Izquierda -->
      <div>
        <CourseHeader course={course} titlePrefix={ficha?.titlePrefix} />
        
        <div class="mt-14">
          <CourseContentBody course={course} modules={modules} instructors={instructors}>
            <Content />
          </CourseContentBody>
        </div>
      </div>

      <!-- Columna Derecha (espacio en el que el sticky se moverá) -->
      <aside>
        <div class="sticky top-32">
          {esBeneficio ? (
            <CourseSidebar
              course={course}
              heading="Ya tenés acceso a este curso"
              ctaHref={`/aula/${entry.id}`}
              ctaLabel="Ingresar al aula"
              ctaIcon="tabler:device-desktop"
              ctaNote="Necesitás las credenciales que te asignó IESL. Si todavía no las tenés, escribinos."
            />
          ) : (
            <CourseSidebar course={course} />
          )}
        </div>
      </aside>

    </div>
  </Section>

  <!-- Certificados. Se omite en los cursos beneficio: el temario del microcurso
       no documenta certificado y no corresponde prometerlo. -->
  {!esBeneficio && (
  <Section class="py-10">
    <div class="max-w-3xl">
      <h2 class="font-bold text-gray-900 text-3xl tracking-tight mb-8">
        Certificado de finalización
      </h2>
      <div class="w-full rounded-3xl flex items-center justify-center">
        <SmartImage
          src={certificateImg}
          alt="Certificado de IESL Institute"
          class="w-full h-auto object-cover shadow-sm select-none"
          loading="lazy"
        />
      </div>
    </div>
  </Section>
  )}

  <!-- Comunidad / Testimonios -->
  <!-- <TestimonialsSection 
    title="Unite a nuestra comunidad" 
    badge="+2000 graduados" 
    testimonials={course.testimonials} 
    class="py-10" 
  /> -->

  <!-- Niveles de Certificación -->
  <!-- <div class="bg-gray-50/50">
    <CertificationsSection />
  </div> -->

  <!-- Formulario de contacto -->
  <ContactSection />
</Layout>
