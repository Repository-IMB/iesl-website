---
import type { Course, CourseModule, CourseInstructor as CourseInstructorType } from "../../../types/course.type";
import { Icon } from "astro-icon/components";
import CourseModules from "./CourseModules.astro";
import CourseInstructor from "./CourseInstructor.astro";
import { highlightTerms } from "../../../lib/highlightTerms";

interface Props {
  course: Course;
  modules?: CourseModule[];
  instructors?: CourseInstructorType[];
}

const { course, modules, instructors } = Astro.props;
---

<div class="flex flex-col">
  <!-- Sobre este curso (cuerpo MDX inyectado vía slot) -->
  <section class="mb-14">
    <h2 class="font-bold text-gray-900 text-3xl tracking-tight mb-6">
      Sobre este curso
    </h2>
    <div class="prose prose-lg max-w-none text-gray-600">
      <slot />
    </div>
  </section>

  <!-- Lo que vas a aprender -->
  {course.learnings && course.learnings.length > 0 && (
    <section class="mb-14">
      <h2 class="font-bold text-gray-900 text-3xl tracking-tight mb-6">
        Lo que vas a aprender
      </h2>
      <ul class="grid sm:grid-cols-2 gap-4">
        {course.learnings.map(learning => (
          <li class="flex items-start gap-3 text-gray-600">
            <Icon
              name="lucide:circle-check-big"
              class="text-primary text-xl shrink-0 mt-0.5"
            />
            <span set:html={highlightTerms(learning)} />
          </li>
        ))}
      </ul>
    </section>
  )}

  <!-- Contenido del curso -->
  <CourseModules modules={modules} />

  <!-- Profesores -->
  <CourseInstructor instructors={instructors} />

</div>
