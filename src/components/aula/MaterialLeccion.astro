---
// Material de apoyo descargable de una lección.
interface Recurso {
  kind: "resumen" | "practica" | "otro";
  label: string;
  key: string | null;
  url: string | null;
}

interface Props {
  recursos: Recurso[];
  cursoSlug: string;
  leccionCode: string;
}

const { recursos, cursoSlug, leccionCode } = Astro.props;

// Los alojados en R2 pasan por la ruta protegida; los externos van directo.
const hrefDe = (recurso: Recurso) =>
  recurso.key
    ? `/api/aula/material?curso=${encodeURIComponent(cursoSlug)}` +
      `&leccion=${encodeURIComponent(leccionCode)}` +
      `&archivo=${encodeURIComponent(recurso.key)}`
    : recurso.url;

const ICONOS: Record<Recurso["kind"], string> = {
  // Documento
  resumen: "M6 2h9l5 5v13a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2zm8 1.5V8h4.5L14 3.5z",
  // Tabla / archivo de datos
  practica: "M4 4h16v16H4V4zm2 2v3h5V6H6zm7 0v3h5V6h-5zM6 11v3h5v-3H6zm7 0v3h5v-3h-5zM6 16v2h5v-2H6zm7 0v2h5v-2h-5z",
  // Adjunto genérico
  otro: "M16.5 6.5v9a4.5 4.5 0 0 1-9 0V7a3 3 0 0 1 6 0v8.5a1.5 1.5 0 0 1-3 0V7h1.5v8.5h.5V7a1.5 1.5 0 0 0-3 0v8.5a3 3 0 0 0 6 0v-9h1.5z",
};
---

<section aria-label="Material de apoyo">
  <h4 class="text-[0.7rem] font-bold tracking-wider text-slate-400 uppercase">
    Material de apoyo
  </h4>

  {
    recursos.length === 0 ? (
      <p class="mt-2 rounded-xl border border-dashed border-slate-200 bg-slate-50 px-4 py-3 text-[0.8rem] text-slate-400">
        El material descargable de esta lección todavía no está publicado.
      </p>
    ) : (
      <ul class="mt-3 flex flex-col gap-2">
        {recursos.map((recurso) => {
          const href = hrefDe(recurso);
          return (
            <li>
              {href ? (
                <a
                  href={href}
                  class="group flex items-center gap-3 rounded-xl border border-slate-200 bg-white px-4 py-3 transition-global hover:border-primary/45 hover:bg-primary/4"
                >
                  <span
                    class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-primary/10"
                    aria-hidden="true"
                  >
                    <svg viewBox="0 0 24 24" class="h-4.5 w-4.5 fill-primary">
                      <path d={ICONOS[recurso.kind]} />
                    </svg>
                  </span>
                  <span class="min-w-0 flex-1 text-[0.875rem] font-semibold text-slate-800">
                    {recurso.label}
                  </span>
                  <svg
                    viewBox="0 0 24 24"
                    class="h-4 w-4 shrink-0 fill-slate-300 transition-global group-hover:fill-primary"
                    aria-hidden="true"
                  >
                    <path d="M12 16l-5-5 1.4-1.4L11 12.2V4h2v8.2l2.6-2.6L17 11l-5 5zM5 18h14v2H5z" />
                  </svg>
                </a>
              ) : (
                <div class="flex items-center gap-3 rounded-xl border border-dashed border-slate-200 bg-slate-50 px-4 py-3">
                  <span
                    class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-white"
                    aria-hidden="true"
                  >
                    <svg viewBox="0 0 24 24" class="h-4.5 w-4.5 fill-slate-300">
                      <path d={ICONOS[recurso.kind]} />
                    </svg>
                  </span>
                  <span class="min-w-0 flex-1 text-[0.875rem] font-semibold text-slate-400">
                    {recurso.label}
                  </span>
                  <span class="shrink-0 text-[0.7rem] font-bold tracking-wider text-slate-400 uppercase">
                    Pendiente
                  </span>
                </div>
              )}
            </li>
          );
        })}
      </ul>
    )
  }
</section>
