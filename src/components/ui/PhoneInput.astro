---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"input">, "type"> {
  label?: string;
  id: string;
  wrapperClass?: string;
}

const { label = "Teléfono", id, class: className, wrapperClass = "", ...rest } = Astro.props;
---
<div class={`phone-input-wrapper w-full ${wrapperClass}`.trim()}>
  {label && (
    <label for={id} class="block font-bold text-sm md:text-base text-gray-700 mb-1.5 ml-1 tracking-wider">
      {label}
    </label>
  )}
  <input
    id={id}
    type="tel"
    autocomplete="tel"
    data-phone-input
    class:list={[
      "w-full px-4 py-3.5 rounded-xl border border-gray-200 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary bg-gray-50 font-inter text-sm md:text-base transition-colors",
      className
    ]}
    {...rest}
  />
</div>

<script>
  let isScriptLoaded = false;
  let intlTelInput: any = null;

  async function loadIntlTelInput() {
    if (isScriptLoaded) return;
    
    try {
      const [intlTelInputModule] = await Promise.all([
        import("intl-tel-input"),
        // @ts-expect-error
        import("intl-tel-input/styles"),
      ]);
      intlTelInput = intlTelInputModule.default;
      isScriptLoaded = true;
    } catch (error) {
      console.error("Failed to load intl-tel-input", error);
    }
  }

  async function setupPhoneInput(input: HTMLInputElement) {
    if ((input as any)._iti) return; // already initialized
    await loadIntlTelInput();

    if (!intlTelInput) return;

    const iti = intlTelInput(input, {
      initialCountry: "auto",
      geoIpLookup(callback: (countryCode: string) => void) {
        fetch("https://ipapi.co/json")
          .then((res) => res.json())
          .then((data) => callback(data.country_code))
          .catch(() => callback("ar"));
      },
      loadUtils: () => import("intl-tel-input/utils"),
    });

    (input as any)._iti = iti;
  }

  function initAllPhoneInputs() {
    const inputs = document.querySelectorAll<HTMLInputElement>("[data-phone-input]");
    inputs.forEach((input) => {
      if (!(input as any)._iti) {
        setupPhoneInput(input);
      }
    });
  }

  document.addEventListener("astro:page-load", initAllPhoneInputs);
  if (document.readyState === 'loading') {
    document.addEventListener("DOMContentLoaded", initAllPhoneInputs);
  } else {
    initAllPhoneInputs();
  }
</script>

<style is:global>
  .iti {
    --iti-path-flags-1x: url("https://cdn.jsdelivr.net/npm/intl-tel-input@26.9.1/build/img/flags.webp");
    --iti-path-flags-2x: url("https://cdn.jsdelivr.net/npm/intl-tel-input@26.9.1/build/img/flags@2x.webp");
    --iti-path-globe-1x: url("https://cdn.jsdelivr.net/npm/intl-tel-input@26.9.1/build/img/globe.webp");
    --iti-path-globe-2x: url("https://cdn.jsdelivr.net/npm/intl-tel-input@26.9.1/build/img/globe@2x.webp");
    width: 100% !important;
  }
</style>
