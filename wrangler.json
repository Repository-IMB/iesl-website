{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "iesl-website",
  "compatibility_date": "2026-07-14",
  "compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "MI_BUCKET_R2",
      "bucket_name": "ieslinstitute",
      "preview_bucket_name": "ieslinstitute-preview"
    }
  ],
  "vars": {
    "SECRET_ACCESS_TOKEN": ""
  }
}
