{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "iesl-website",
	"compatibility_date": "2026-07-13",
	"compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"r2_buckets": [
		{
			"binding": "MI_BUCKET_R2",
			"bucket_name": "ieslinstitute",
			"preview_bucket_name": "ieslinstitute-preview"
		}
	],
	// Aula virtual: alumnos y matriculas.
	// En local wrangler ignora el database_id y usa estado en disco
	// (.wrangler/state/); el id real solo importa para --remote y deploy.
	"d1_databases": [
		{
			"binding": "DB_AULA",
			"database_name": "iesl-aula",
			"database_id": "a5528453-c073-4698-b55f-2c647db9c50f"
		}
	]
}
