{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "iesl-website",
	"compatibility_date": "2026-07-13",
	"compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"r2_buckets": [
		{
			"binding": "MI_BUCKET_R2",
			"bucket_name": "ieslinstitute",
			"preview_bucket_name": "ieslinstitute-preview"
		}
	],
	// Aula virtual: alumnos y matriculas. El database_id se completa al crear
	// la base en la cuenta de Cloudflare del proyecto:
	//   npx wrangler d1 create iesl-aula
	// En local wrangler usa estado en disco (.wrangler/state/) y no necesita id.
	"d1_databases": [
		{
			"binding": "DB_AULA",
			"database_name": "iesl-aula",
			"database_id": "local"
		}
	]
}
